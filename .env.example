# ============================================================
# .env.example — Module 1: Local File System / Organization Server
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit a real .env file to the repository.
# ============================================================

# Path to the local organization files directory.
# Use a relative path (relative to the project root) so the
# project remains portable — no machine-specific absolute paths.
SYNC_FOLDER=./organization/files

# Module 3: FastAPI backend origin used by the synchronization agent.
# Set this to the deployed backend URL (for example an EC2 public origin).
# Leave empty to run the agent with LoggingEventSender only.
# Do not treat localhost as the production address.
BACKEND_URL=

# Optional backend bind settings (used when starting uvicorn locally / on EC2)
# BACKEND_HOST=0.0.0.0
# BACKEND_PORT=8000

# Module 4: Amazon S3 file-content storage.
# STORAGE_ADAPTER=memory keeps the M3 in-memory adapter (default, no AWS).
# STORAGE_ADAPTER=s3 uses S3FileStorage. Credentials come from the AWS
# default chain — never commit access keys.
# STORAGE_ADAPTER=memory
# AWS_REGION=
# S3_BUCKET=
# S3_PREFIX=organization/files

# Module 5: Amazon RDS PostgreSQL metadata (never file contents).
# METADATA_ADAPTER=memory keeps the M3 in-memory repository (default).
# METADATA_ADAPTER=rds uses RdsMetadataRepository.
# Do not commit RDS_PASSWORD or other secrets.
# METADATA_ADAPTER=memory
# RDS_HOST=
# RDS_PORT=5432
# RDS_DATABASE=
# RDS_USERNAME=
# RDS_PASSWORD=
# RDS_SSLMODE=require

# Module 6: Security & IAM.
# Optional API Key for authenticating agent HTTP requests to backend.
# API_KEY=

